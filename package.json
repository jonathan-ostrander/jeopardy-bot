{
  "name": "jeopardy-bot",
  "version": "1.0.0",
  "description": "Discord bot for running Jeopardy games",
  "main": "dist/bot/index.js",
  "scripts": {
    "build": "bun build src/bot/index.ts --outdir dist/bot --target node && bun build src/scraper/index.ts --outdir dist/scraper --target node",
    "start:bot": "bun run src/bot/index.ts",
    "start:scraper": "bun run src/scraper/index.ts",
    "dev:bot": "bun --watch run src/bot/index.ts",
    "dev:scraper": "bun --watch run src/scraper/index.ts"
  },
  "keywords": ["discord", "bot", "jeopardy"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  },
  "private": true
}
