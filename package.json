{
  "name": "jeopardy-bot",
  "version": "2.0.0",
  "description": "Discord Activity for running Jeopardy games in voice channels",
  "main": "dist/server.js",
  "scripts": {
    "build:client": "cd src/activity/client && npm install && npm run build",
    "build:server": "bun build src/server.ts --outdir dist --target node",
    "build": "npm run build:client && npm run build:server",
    "start": "bun run dist/server.js",
    "dev": "bun --watch run src/server.ts",
    "dev:client": "cd src/activity/client && npm run dev",
    "start:scraper": "bun run src/scraper/index.ts"
  },
  "keywords": ["discord", "activity", "jeopardy"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  },
  "private": true
}
